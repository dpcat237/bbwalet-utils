# Committed configuration defaults (APP_-prefixed env vars, loaded by the
# Makefile run-* targets and read via config.Load). Developer-local overrides
# go in .env.local (gitignored); shared dev overrides go in .env.dev (also
# gitignored — it may hold a real API token).
APP_HTTP_TIMEOUT=10s
APP_WALLET_BASE_URL=https://rest.budgetbakers.com/wallet
APP_OUTPUT_DIR=out

# Wallet REST API bearer token — Premium; generate at
# https://web.budgetbakers.com/settings/rest-api. NEVER commit a real value;
# set it in .env.local or .env.dev (both gitignored).
# APP_WALLET_API_TOKEN=
